{% from '_macros/action_buttons.html.twig' import action_buttons %}
{% extends 'base.html.twig' %}

{% block title %}Éléments de sécurité{% endblock %}

{% block body %}
    <div class="page-header">
        <div>
            <h1>🦺 Éléments de sécurité</h1>
            <p class="text-muted text-sm">{{ element_securites|length }} élément{{ element_securites|length > 1 ? 's' : '' }}</p>
        </div>
        <a href="{{ path('app_element_securite_new') }}" class="btn btn-success">+ Créer</a>
    </div>

    <div class="table-wrapper">
        <table class="table">
            <thead>
                <tr>
                    <th>Picto</th>
                    <th>Id</th>
                    <th>Nom / Code</th>
                    <th>Fichier picto</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for es in element_securites %}
                {% set pictoFile = es.picto ? es.picto : (es.id ~ '.png') %}
                <tr>
                    <td style="width:56px;">
                        <img src="{{ asset('PictoElementSecuritePNG/' ~ pictoFile) }}"
                             alt="{{ es.nom }}"
                             style="width:44px;height:44px;object-fit:contain;"
                             onerror="this.style.display='none'">
                    </td>
                    <td>{{ es.id }}</td>
                    <td><strong>{{ es.nom }}</strong></td>
                    <td class="text-muted text-sm">{{ es.picto ?? es.id ~ '.png (défaut)' }}</td>
                    <td>{{ action_buttons('app_element_securite_show', 'app_element_securite_edit', es.id) }}</td>
                </tr>
            {% else %}
                <tr><td colspan="5" class="text-muted">Aucun élément de sécurité.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="mt-2">
        <a href="{{ path('app_dashboard') }}" class="btn btn-secondary">← Retour au dashboard</a>
    </div>
{% endblock %}
