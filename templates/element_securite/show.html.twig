{% extends 'base.html.twig' %}

{% block title %}Élément sécurité — {{ element_securite.nom }}{% endblock %}

{% block body %}
    <div class="page-header">
        <h1>🦺 {{ element_securite.nom }}</h1>
        <div class="btn-group">
            <a href="{{ path('app_element_securite_edit', {'id': element_securite.id}) }}" class="btn btn-secondary">✏️ Modifier</a>
            <a href="{{ path('app_element_securite_index') }}" class="btn btn-outline">← Retour à la liste</a>
        </div>
    </div>

    <div class="card" style="max-width:500px;">
        <div style="display:flex;align-items:center;gap:1.5rem;margin-bottom:1.25rem;">
            {% set pictoFile = element_securite.picto ? element_securite.picto : (element_securite.id ~ '.png') %}
            <img src="{{ asset('PictoElementSecuritePNG/' ~ pictoFile) }}"
                 alt="{{ element_securite.nom }}"
                 style="width:90px;height:90px;object-fit:contain;border:1px solid #ddd;border-radius:8px;padding:6px;background:#fff;"
                 onerror="this.style.display='none'">
            <div>
                <div style="font-size:1.3rem;font-weight:700;">{{ element_securite.nom }}</div>
                <div class="text-muted text-sm">ID : {{ element_securite.id }}</div>
                <div class="text-muted text-sm">Fichier : {{ element_securite.picto ?? (element_securite.id ~ '.png') }}</div>
            </div>
        </div>
    </div>

    <div class="mt-2">
        {{ include('element_securite/_delete_form.html.twig') }}
    </div>
{% endblock %}
