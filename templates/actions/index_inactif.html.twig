{% extends 'base.html.twig' %}

{% block title %}Actions désactivées{% endblock %}

{% block body %}
    <h1>Actions désactivées</h1>

    <form method="post" action="{{ path('app_actions_bulk_reactivate') }}" id="bulk-reactivate-form">
        <input type="hidden" name="_token" value="{{ csrf_token('bulk_reactivate_actions') }}">

        <div class="mb-3" style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
            <button type="submit" class="btn btn-success" id="bulk-reactivate-btn" disabled>
                ✓ Réactiver la sélection (<span id="bulk-count">0</span>)
            </button>
            <a href="{{ path('app_actions_index') }}" class="btn btn-primary">← Retour aux actions actives</a>
            <span class="text-muted text-sm">Cochez les lignes à réactiver puis cliquez sur le bouton.</span>
        </div>

        <table class="table">
            <thead>
                <tr>
                    <th style="width:40px; text-align:center;">
                        <input type="checkbox" id="bulk-select-all" title="Tout cocher / décocher">
                    </th>
                    <th>Id</th>
                    <th>Désactivé le</th>
                    <th>Nécessaires</th>
                    <th>Code Produit</th>
                    <th>Id Contenant</th>
                    <th>Code Moyen Dilution</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for action in actions %}
                <tr>
                    <td style="text-align:center;">
                        <input type="checkbox" name="ids[]" value="{{ action.id }}" class="bulk-row-check">
                    </td>
                    <td>{{ action.id }}</td>
                    <td>{{ action.dateDesactivation ? action.dateDesactivation|date('d/m/Y H:i') : '—' }}</td>
                    <td>
                        {% for necessaire in action.necessaire %}
                            {{ necessaire.code }}{% if not loop.last %}, {% endif %}
                        {% endfor %}
                    </td>
                    <td>{{ action.meoProduit ? action.meoProduit.produit.code : '-' }}</td>
                    <td>{{ action.meoProduit ? (action.meoProduit.contenant ? action.meoProduit.contenant.id : '0') : '-' }}</td>
                    <td>{{ action.meoProduit ? (action.meoProduit.moyenDosage ? action.meoProduit.moyenDosage.code : '0') : '-' }}</td>
                    <td>
                        <a href="{{ path('app_actions_show', {'id': action.id}) }}">Afficher</a>
                        <a href="{{ path('app_actions_edit', {'id': action.id}) }}">Modifier</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="8">Aucune action désactivée</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </form>

    <script>
    (function() {
        var selectAll = document.getElementById('bulk-select-all');
        var rowChecks = document.querySelectorAll('.bulk-row-check');
        var btn       = document.getElementById('bulk-reactivate-btn');
        var counter   = document.getElementById('bulk-count');

        function refresh() {
            var n = 0;
            rowChecks.forEach(function(c) { if (c.checked) n++; });
            counter.textContent = n;
            btn.disabled = (n === 0);
        }

        if (selectAll) {
            selectAll.addEventListener('change', function() {
                rowChecks.forEach(function(c) { c.checked = selectAll.checked; });
                refresh();
            });
        }
        rowChecks.forEach(function(c) {
            c.addEventListener('change', refresh);
        });
        refresh();
    })();
    </script>
{% endblock %}
