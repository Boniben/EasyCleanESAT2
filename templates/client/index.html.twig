{% extends 'base.html.twig' %}
{% block title %}Liste des clients{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
    /* ============================================================
       LISTE DES CLIENTS — Grille de cards
       ============================================================ */
    .clients-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1.25rem;
        margin-top: 1rem;
    }
    @media (max-width: 1100px) { .clients-grid { grid-template-columns: repeat(3, 1fr); } }
    @media (max-width: 800px)  { .clients-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 480px)  { .clients-grid { grid-template-columns: 1fr; } }

    .client-card {
        display: flex;
        flex-direction: column;
        background: white;
        border: 2px solid var(--color-border);
        border-radius: var(--radius-xl, 14px);
        text-decoration: none;
        color: var(--color-text);
        overflow: hidden;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 2px 10px rgba(61,90,128,0.07);
    }
    .client-card:hover {
        border-color: var(--color-primary);
        transform: translateY(-4px);
        box-shadow: 0 12px 32px rgba(61,90,128,0.18);
        color: var(--color-text);
    }
    .client-card__photo {
        background: linear-gradient(180deg, #f5f9fc, #eaf0f7);
        height: 180px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
        border-bottom: 1px solid var(--color-border);
    }
    .client-card__photo img {
        max-height: 100%;
        max-width: 100%;
        object-fit: contain;
        display: block;
    }
    .client-card__photo--empty {
        font-size: 3rem;
        color: #c6d4e3;
    }
    .client-card__title {
        font-family: var(--font-heading, sans-serif);
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--color-primary);
        text-align: center;
        padding: 1rem 0.75rem;
        line-height: 1.3;
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .client-card:hover .client-card__title {
        color: var(--color-primary-hover, var(--color-primary));
    }

    .clients-empty {
        text-align: center;
        padding: 3rem 1rem;
        color: var(--color-text-secondary);
        background: white;
        border: 1px dashed var(--color-border);
        border-radius: var(--radius-xl, 14px);
    }
    </style>
{% endblock %}

{% block body %}
    <div class="page-header">
        <h1>Liste des clients</h1>
        {% if app.user and is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_client_new') }}" class="btn btn-primary">+ Ajouter un client</a>
        {% else %}
            <a href="{{ path('app_login') }}" class="btn btn-danger">+ Ajouter un client</a>
        {% endif %}
    </div>

    {% if clients|length > 0 %}
        <div class="clients-grid">
            {% for client in clients %}
                <a href="{{ path('app_client_show', {'id': client.id}) }}" class="client-card" title="Voir le client {{ client.nom }}">
                    <div class="client-card__photo">
                        {% if client.picto %}
                            <img src="{{ asset('PictoClientsPNG/' ~ client.picto) }}" alt="{{ client.nom }}" onerror="this.style.display='none'; this.parentElement.classList.add('client-card__photo--empty'); this.parentElement.innerHTML='👤';">
                        {% else %}
                            <div class="client-card__photo--empty">👤</div>
                        {% endif %}
                    </div>
                    <div class="client-card__title">{{ client.nom }}</div>
                </a>
            {% endfor %}
        </div>
    {% else %}
        <div class="clients-empty">
            <p>Aucun client trouvé</p>
        </div>
    {% endif %}
{% endblock %}
