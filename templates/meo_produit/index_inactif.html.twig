{% extends 'base.html.twig' %}

{% block title %}MeoProduit index{% endblock %}

{% block body %}
    <h1>Liste des mise en oeuvre produit - Désactivées</h1>

    <form method="get" action="{{ path('app_meo_produit_inactif') }}" style="display: flex; gap: 12px; align-items: flex-end; flex-wrap: wrap; margin-bottom: 20px;">
        <div>
            <label for="meo-produit-inactif-filter-produit" style="display: block; margin-bottom: 4px;">Filtrer par produit</label>
            <select id="meo-produit-inactif-filter-produit" name="produit" class="form-select">
                <option value="">Tous les produits</option>
                {% for produit in produits %}
                    <option value="{{ produit.id }}" {% if selected_produit_id == produit.id %}selected{% endif %}>
                        {{ produit.code }} - {{ produit.nom }}
                    </option>
                {% endfor %}
            </select>
        </div>
        <button type="submit" class="btn btn-primary">Filtrer</button>
        {% if selected_produit_id %}
            <a href="{{ path('app_meo_produit_inactif') }}" class="btn btn-outline-secondary">Reinitialiser</a>
        {% endif %}
    </form>

    <form method="post" action="{{ path('app_meo_produit_bulk_reactivate') }}" id="bulk-reactivate-form">
        <input type="hidden" name="_token" value="{{ csrf_token('bulk_reactivate_meo_produit') }}">

        <div class="mb-3" style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
            <button type="submit" class="btn btn-success" id="bulk-reactivate-btn" disabled>
                ✓ Réactiver la sélection (<span id="bulk-count">0</span>)
            </button>
            <a href="{{ path('app_meo_produit_index') }}" class="btn btn-primary">← Retour aux mises en œuvre actives</a>
            <span class="text-muted text-sm">Cochez les lignes à réactiver puis cliquez sur le bouton.</span>
        </div>

        <table class="table">
            <thead>
                <tr>
                    <th style="width:40px; text-align:center;">
                        <input type="checkbox" id="bulk-select-all" title="Tout cocher / décocher">
                    </th>
                    <th>Id</th>
                    <th>Désactivé le</th>
                    <th>Code Meo produit</th>
                    <th>Nom produit</th>
                    <th>Nom contenant</th>
                    <th>Nom moyen dilution</th>
                    <th>Volume de Produit</th>
                    <th>actions</th>
                </tr>
            </thead>
            <tbody>
            {% for meo_produit in meo_produits %}
                <tr>
                    <td style="text-align:center;">
                        <input type="checkbox" name="ids[]" value="{{ meo_produit.id }}" class="bulk-row-check">
                    </td>
                    <td>{{ meo_produit.id }}</td>
                    <td>{{ meo_produit.dateDesactivation ? meo_produit.dateDesactivation|date('d/m/Y H:i') : '—' }}</td>
                    <td>
                    {{
                        (meo_produit.produit ? meo_produit.produit.code : '')
                        ~ '.0' ~
                        (meo_produit.contenant ? meo_produit.contenant.id : '0')
                        ~ '.' ~
                        (meo_produit.moyenDosage ? meo_produit.moyenDosage.code : '00')
                    }}
                    </td>
                    <td>{{ meo_produit.produit ? meo_produit.produit.nom : '-' }}</td>
                    <td>{{ meo_produit.contenant ? meo_produit.contenant.nom : '-' }}</td>
                    <td>{{ meo_produit.moyenDosage ? meo_produit.moyenDosage.nom : '-' }}</td>
                    <td>{{ meo_produit.volumeProduit }}</td>
                    <td>
                        <a href="{{ path('app_meo_produit_show', {'id': meo_produit.id}) }}">Afficher</a>
                        <a href="{{ path('app_meo_produit_edit', {'id': meo_produit.id}) }}">Modifier</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="9">no records found</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </form>

    <script>
    (function() {
        var selectAll = document.getElementById('bulk-select-all');
        var rowChecks = document.querySelectorAll('.bulk-row-check');
        var btn       = document.getElementById('bulk-reactivate-btn');
        var counter   = document.getElementById('bulk-count');

        function refresh() {
            var n = 0;
            rowChecks.forEach(function(c) { if (c.checked) n++; });
            counter.textContent = n;
            btn.disabled = (n === 0);
        }

        if (selectAll) {
            selectAll.addEventListener('change', function() {
                rowChecks.forEach(function(c) { c.checked = selectAll.checked; });
                refresh();
            });
        }
        rowChecks.forEach(function(c) {
            c.addEventListener('change', refresh);
        });
        refresh();
    })();
    </script>
{% endblock %}
