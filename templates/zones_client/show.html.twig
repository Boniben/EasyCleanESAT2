{% extends 'base.html.twig' %}

{% block title %}Zone — {{ zones_client.nom }}{% endblock %}

{% block body %}

    {% set client = zones_client.sitesClient.client %}

    {# ---- Titre + fil d'Ariane + bouton modifier (en haut de la page) ---- #}
    <div class="page-header" style="display:flex; align-items:center; justify-content:space-between; gap:1rem;">
        <div>
            <h1 style="margin-bottom:0.6rem;">{{ zones_client.nom }}</h1>
            {# Fil d'Ariane en pastilles colorées #}
            <div style="display:flex; flex-wrap:wrap; align-items:center; gap:0.4rem 0.6rem; font-size:1rem;">
                {# Client #}
                <span style="display:inline-flex; align-items:center; gap:0.35rem; padding:0.35rem 0.75rem; background:#fff4d6; border:1.5px solid #f0b73b; border-radius:999px; font-weight:700; color:#7a5300;">
                    👤 {{ zones_client.sitesClient.client.nom }}
                </span>
                <span style="color:#bbb; font-weight:700;">›</span>
                {# Site #}
                <span style="display:inline-flex; align-items:center; gap:0.35rem; padding:0.35rem 0.75rem; background:var(--color-primary-light); border:1.5px solid var(--color-primary-soft); border-radius:999px; font-weight:700; color:var(--color-primary-hover);">
                    🏢 {{ zones_client.sitesClient.nom }}
                </span>
                <span style="color:#bbb; font-weight:700;">›</span>
                {# Zone #}
                <span style="display:inline-flex; align-items:center; gap:0.35rem; padding:0.45rem 0.95rem; background:#e8f5ee; border:2px solid #1a6b3d; border-radius:999px; font-weight:800; color:#1a6b3d; font-size:1.05rem;">
                    📍 {{ zones_client.nom }}
                </span>
            </div>
        </div>
        <div class="btn-group">
            <a href="{{ path('app_zones_client_edit', {'id': zones_client.id}) }}" class="btn btn-secondary">Modifier le nom de la zone</a>
        </div>
    </div>

    {# ============================================================
       Bandeau : Card Client (gauche) + Card Type de zone (droite)
       ============================================================ #}
    <div style="display:flex; gap:1rem; align-items:stretch; margin-bottom:1.25rem; flex-wrap:wrap;">

        {# ---- Card Client (gauche, identique à /client) ---- #}
        <a href="{{ path('app_client_show', {'id': client.id}) }}"
           style="flex:0 0 240px; display:flex; flex-direction:column; background:white; border:2px solid var(--color-border); border-radius:var(--radius-xl, 14px); overflow:hidden; box-shadow:0 2px 10px rgba(61,90,128,0.07); text-decoration:none; color:var(--color-text); transition:all .2s cubic-bezier(0.4, 0, 0.2, 1);"
           onmouseenter="this.style.borderColor='var(--color-primary)'; this.style.transform='translateY(-2px)'; this.style.boxShadow='0 8px 24px rgba(61,90,128,0.18)';"
           onmouseleave="this.style.borderColor='var(--color-border)'; this.style.transform=''; this.style.boxShadow='0 2px 10px rgba(61,90,128,0.07)';"
           title="Retour à la fiche du client {{ client.nom }}">
            <div style="background:linear-gradient(180deg, #f5f9fc, #eaf0f7); height:160px; display:flex; align-items:center; justify-content:center; padding:1rem; border-bottom:1px solid var(--color-border);">
                {% if client.picto %}
                    <img src="{{ asset('PictoClientsPNG/' ~ client.picto) }}"
                         alt="{{ client.nom }}"
                         style="max-height:100%; max-width:100%; object-fit:contain; display:block;"
                         onerror="this.style.display='none'; this.parentElement.innerHTML='<div style=&quot;font-size:3rem;color:#c6d4e3;&quot;>👤</div>';">
                {% else %}
                    <div style="font-size:3rem; color:#c6d4e3;">👤</div>
                {% endif %}
            </div>
            <div style="font-family:var(--font-heading, sans-serif); font-size:1.05rem; font-weight:700; color:var(--color-primary); text-align:center; padding:0.85rem 0.75rem; line-height:1.3; flex:1; display:flex; align-items:center; justify-content:center;">
                {{ client.nom }}
            </div>
        </a>

        {# ---- Card Type de zone (droite, picto x2.5 = 180px) ---- #}
        {% if zones_client.typeZone %}
            {% set tzPicto = zones_client.typeZone.picto ? zones_client.typeZone.picto : (zones_client.typeZone.id ~ '.png') %}
            <div style="flex:1 1 400px; display:flex; align-items:center; gap:1.5rem; padding:1rem 1.25rem; background:white; border:1px solid var(--color-border); border-radius:var(--radius-lg, 10px); box-shadow:0 2px 8px rgba(61,90,128,0.06);">
                <img src="{{ asset('PictoTypeZonePNG/' ~ tzPicto) }}"
                     alt="{{ zones_client.typeZone.nom }}"
                     title="Type de zone : {{ zones_client.typeZone.nom }}"
                     style="width:180px; height:180px; object-fit:contain; flex-shrink:0;"
                     onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                <div style="display:none; width:180px; height:180px; align-items:center; justify-content:center; font-size:5rem; flex-shrink:0;">📍</div>
                <div>
                    <div style="font-size:0.78rem; color:var(--color-text-secondary); text-transform:uppercase; letter-spacing:0.05em; font-weight:700; margin-bottom:0.3rem;">Type de zone</div>
                    <div style="font-size:1.6rem; font-weight:800; color:var(--color-primary-hover); line-height:1.2;">{{ zones_client.typeZone.nom }}</div>
                    {% if zones_client.typeZone.description %}
                        <div style="margin-top:0.4rem; color:var(--color-text-secondary); font-size:0.95rem; line-height:1.4;">{{ zones_client.typeZone.description }}</div>
                    {% endif %}
                </div>
            </div>
        {% endif %}

    </div>

    {# Bloc Supports — bouton d'ajout intégré dans la card #}
    <div class="card">
        <div style="display:flex; align-items:center; justify-content:space-between; gap:1rem; margin-bottom:0.75rem;">
            <h3 style="margin:0;">Supports ({{ zones_client.supportsClient|length }})</h3>
            <a href="{{ path('app_support_client_new', {'zone_id': zones_client.id}) }}" class="btn btn-success btn-sm">+ Ajouter un support</a>
        </div>

        {% if zones_client.supportsClient|length > 0 %}
            <div style="display: flex; flex-wrap: wrap; gap: 1rem; padding: 0.5rem 0;">
                {% for support in zones_client.supportsClient %}
                    <div style="display: flex; flex-direction: column; align-items: center; gap: 0.4rem;" title="{{ support.typeSupport.nom }}">
                        {% if support.typeSupport.picto %}
                            <img src="{{ asset('PictoTypeSupportPNG/' ~ support.typeSupport.picto) }}"
                                 alt="{{ support.typeSupport.nom }}"
                                 style="width: 56px; height: 56px; object-fit: contain;">
                        {% else %}
                            <div style="width: 56px; height: 56px; background: var(--color-primary-light); border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; font-size: 1.5rem;">🪣</div>
                        {% endif %}
                        <span style="font-size:0.72rem; color:var(--color-text-secondary); text-align:center; max-width:70px;">{{ support.typeSupport.nom }}</span>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <p class="text-muted text-sm" style="margin-top:0.75rem;">Aucun support pour cette zone</p>
        {% endif %}
    </div>

    <div class="btn-group mt-3">
        <a href="{{ path('app_client_show', {'id': zones_client.sitesClient.client.id}) }}" class="btn btn-secondary">← Retour au client</a>
        {% if app.user and is_granted('ROLE_ADMIN') %}
            {{ include('zones_client/_delete_form.html.twig') }}
        {% else %}
            <a href="{{ path('app_login') }}" class="btn btn-danger">Supprimer</a>
        {% endif %}
    </div>
{% endblock %}
