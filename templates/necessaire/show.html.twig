{% extends 'base.html.twig' %}

{% block title %}Necessaire{% endblock %}

{% block body %}
    <h1>Necessaire {{ include('necessaire/_deactivate_form.html.twig') }}</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ necessaire.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ necessaire.nom }}</td>
            </tr>
            <tr>
                <th>Code</th>
                <td>{{ necessaire.code }}</td>
            </tr>
            <tr>
                <th>Type</th>
                <td>{{ necessaire.typeNecessaire ? necessaire.typeNecessaire.nom : '' }}</td>
            </tr>
            <tr>
                <th>Picto</th>
                <td>
                    {% set fname = (necessaire.typeNecessaire and necessaire.typeNecessaire.nom|lower == 'consommable')
                        ? '_' ~ necessaire.code
                        : necessaire.code %}
                    <img src="{{ asset('PictoNecessairePNG/' ~ fname ~ '.png') }}"
                         alt="{{ necessaire.nom }}"
                         style="width:100px;height:100px;object-fit:contain;border:1px solid #ddd;padding:4px;"
                         onerror="this.style.display='none'">
                </td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_necessaire_index') }}">Retour a la liste</a>

    <a href="{{ path('app_necessaire_edit', {'id': necessaire.id}) }}">Modifier</a>

    {{ include('necessaire/_delete_form.html.twig') }}
{% endblock %}
