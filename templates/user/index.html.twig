{% extends 'base.html.twig' %}

{% block title %}Gestion des utilisateurs{% endblock %}

{% block body %}
    <div style="margin-bottom: 20px;">
        <h1 style="text-align:center; margin:0 0 12px 0;">Gestion des utilisateurs</h1>
        <div style="display:flex; justify-content:flex-end; gap:8px;">
            <a href="{{ path('app_user_new') }}" class="btn btn-success" style="font-size: 16px; padding: 10px 20px;">+ Créer un utilisateur</a>
        </div>
    </div>

    <table class="table">
        <thead>
            <tr>
                <th style="width:50px;">Id</th>
                <th>Email</th>
                <th>Rôle</th>
                <th style="width:200px;">Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for user in users %}
            <tr>
                <td>{{ user.id }}</td>
                <td>
                    {{ user.email }}
                    {% if app.user and user.id == app.user.id %}
                        <span style="margin-left:6px; padding:2px 8px; background:#dbeafe; color:#1e40af; border-radius:999px; font-size:0.75rem; font-weight:600;">vous</span>
                    {% endif %}
                </td>
                <td>
                    {% if 'ROLE_ADMIN' in user.roles %}
                        <span style="display:inline-flex; align-items:center; gap:0.3rem; padding:0.25rem 0.7rem; background:#fbd8d8; color:#b91c1c; border:1px solid #f5b8b8; border-radius:999px; font-size:0.82rem; font-weight:700;">
                            🔒 Administrateur
                        </span>
                    {% else %}
                        <span style="display:inline-flex; align-items:center; gap:0.3rem; padding:0.25rem 0.7rem; background:#dcfce7; color:#166534; border:1px solid #bbf7d0; border-radius:999px; font-size:0.82rem; font-weight:600;">
                            👤 Utilisateur
                        </span>
                    {% endif %}
                </td>
                <td>
                    <a href="{{ path('app_user_edit', {'id': user.id}) }}" class="btn btn-sm btn-secondary">Modifier</a>
                    {% if app.user and user.id != app.user.id %}
                        <form method="post" action="{{ path('app_user_delete', {'id': user.id}) }}" style="display:inline;" onsubmit="return confirm('Supprimer définitivement {{ user.email }} ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                            <button type="submit" class="btn btn-sm btn-danger">Supprimer</button>
                        </form>
                    {% endif %}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4" style="text-align:center; color:var(--color-text-secondary); font-style:italic;">Aucun utilisateur.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <div class="btn-group mt-3">
        <a href="{{ path('app_dashboard') }}" class="btn btn-secondary">← Retour au tableau de bord</a>
    </div>
{% endblock %}
