{% extends 'base.html.twig' %}

{% block title %}Contenant{% endblock %}

{% block body %}
    <h1>Contenant</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ contenant.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ contenant.nom }}</td>
            </tr>
            <tr>
                <th>Volume eau</th>
                <td>{{ contenant.volumeEau }}{% if contenant.uniteVolume %} {{ contenant.uniteVolume.nom }}{% endif %}</td>
            </tr>
            <tr>
                <th>Picto</th>
                <td>
                    {% if contenant.picto %}
                        <img src="{{ asset('PictoContenantPNG/' ~ contenant.picto) }}"
                             alt="{{ contenant.nom }}"
                             style="width:100px;height:100px;object-fit:contain;border:1px solid #ddd;padding:4px;"
                             onerror="this.style.display='none'">
                    {% endif %}
                    <img src="{{ asset('PictoContenantPNG/' ~ contenant.id ~ '.png') }}"
                         alt="{{ contenant.nom }}"
                         style="width:100px;height:100px;object-fit:contain;border:1px solid #ddd;padding:4px;"
                         onerror="this.style.display='none'">
                </td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_contenant_index') }}" class="btn btn-secondary">Retour a la liste</a>

    <a href="{{ path('app_contenant_edit', {'id': contenant.id}) }}">Modifier</a>

    <form method="post" action="{{ path('app_contenant_toggle_actif', {'id': contenant.id}) }}" style="display:inline;">
        <input type="hidden" name="_token" value="{{ csrf_token('toggle_actif' ~ contenant.id) }}">
        <button type="submit" class="btn {% if contenant.actif %}btn-success{% else %}btn-danger{% endif %}" onclick="return confirm('Confirmer le changement d\'état ?');">
            {% if contenant.actif %}✓ Actif{% else %}✗ Désactivé{% endif %}
        </button>
    </form>

    {{ include('contenant/_delete_form.html.twig') }}
{% endblock %}
